diff --git a/src/AutoRemesher/researchhash.h b/src/AutoRemesher/researchhash.h
new file mode 100644
index 0000000..e0d568a
--- /dev/null
+++ b/src/AutoRemesher/researchhash.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Quadami contributors
+// Research only (platform divergence study, 2026-10-26), never merged: FNV-1a hashes of the
+// bits of intermediate results, written as stage diagnostics "rh" so that runs on different
+// platforms can be compared stage by stage. Reads only; changes no result.
+#ifndef AUTO_REMESHER_RESEARCH_HASH_H
+#define AUTO_REMESHER_RESEARCH_HASH_H
+
+#include "diagnostics.h"
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace AutoRemesher {
+namespace ResearchHash {
+
+    inline uint64_t mix(uint64_t h, const void* data, size_t bytes)
+    {
+        const unsigned char* c = static_cast<const unsigned char*>(data);
+        for (size_t i = 0; i < bytes; ++i) {
+            h ^= c[i];
+            h *= 1099511628211ULL;
+        }
+        return h;
+    }
+
+    inline uint64_t seed() { return 1469598103934665603ULL; }
+
+    template <class T>
+    uint64_t flat(const std::vector<T>& v, uint64_t h = seed())
+    {
+        const uint64_t n = v.size();
+        h = mix(h, &n, sizeof n);
+        if (!v.empty())
+            h = mix(h, v.data(), v.size() * sizeof(T));
+        return h;
+    }
+
+    template <class T>
+    uint64_t nested(const std::vector<std::vector<T>>& v, uint64_t h = seed())
+    {
+        const uint64_t n = v.size();
+        h = mix(h, &n, sizeof n);
+        for (const auto& x : v)
+            h = flat(x, h);
+        return h;
+    }
+
+    inline std::string hex(uint64_t h)
+    {
+        char buffer[17];
+        std::snprintf(buffer, sizeof buffer, "%016llx", (unsigned long long)h);
+        return buffer;
+    }
+
+    inline DiagnosticRecord record(const char* point, uint64_t h, size_t island = DiagnosticRecord::noIsland)
+    {
+        DiagnosticRecord r("rh", island);
+        r.label("point", point);
+        r.label("h", hex(h));
+        return r;
+    }
+
+}
+}
+
+#endif
