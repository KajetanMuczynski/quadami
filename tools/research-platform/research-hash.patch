+// Research only: evaluates the math functions the core calls on the arguments in IN (records of
+// a uint32 function id and two doubles) and writes one double per record to OUT, so the C library
+// the CLI links can be compared across platforms argument by argument.
+static int researchLibm(const char* inPath, const char* outPath)
+{
+    FILE* in = std::fopen(inPath, "rb");
+    FILE* out = std::fopen(outPath, "wb");
+    if (!in || !out)
+        return 2;
+    uint32_t id;
+    double a, b;
+    while (std::fread(&id, sizeof id, 1, in) == 1 && std::fread(&a, sizeof a, 1, in) == 1 && std::fread(&b, sizeof b, 1, in) == 1) {
+        volatile double x = a, y = b; // no folding, no vectorized math library
+        double r = 0.0;
+        switch (id) {
+        case 0: r = std::sin(x); break;
+        case 1: r = std::cos(x); break;
+        case 2: r = std::atan2(x, y); break;
+        case 3: r = std::acos(x); break;
+        case 4: r = std::exp(x); break;
+        case 5: r = std::log(x); break;
+        case 6: r = std::log10(x); break;
+        case 7: r = std::pow(x, y); break;
+        case 8: r = std::hypot(x, y); break;
+        }
+        volatile double v = r;
+        const double w = v;
+        std::fwrite(&w, sizeof w, 1, out);
+    }
+    std::fclose(in);
+    std::fclose(out);
+    return 0;
+}
